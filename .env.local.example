# Copy to .env.local (gitignored) and fill in real values.
# Never commit .env.local. Never reference these in a client component
# except the two NEXT_PUBLIC_ ones below, which are safe to expose
# (Supabase anon key is designed to be public; RLS is what protects data).

# Supabase Dashboard -> Project (semestre) -> Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase Dashboard -> Project (semestre) -> Settings -> API -> Project API keys -> anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Not used until commit 2. Google AI Studio -> aistudio.google.com/apikey.
# Server-side only — never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=
